# Database connection string (use the Supabase Session pooler string, URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT secret key for signing tokens (minimum 32 characters, e.g. generate with 'openssl rand -hex 32')
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long

# JWT signing algorithm
JWT_ALGORITHM=HS256

# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for CORS (default: http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret invite code required during registration to assign the instructor role
INSTRUCTOR_INVITE_CODE=replace_with_instructor_invite_code
